<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- светлая тема окна: раньше окно всегда было тёмным — при светлой теме приложения белые значки строки состояния и тёмная вспышка при запуске -->
    <style name="Theme.Phoenix" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <!-- невидимый экран ярлыков: сразу закрывается -->
    <style name="Theme.Phoenix.Shortcut" parent="android:Theme.Translucent.NoTitleBar" />
</resources>
